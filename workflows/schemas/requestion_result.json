{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason", "evidence"],
  "properties": {
    "verdict": {
      "enum": ["still_a_problem", "overtaken"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  }
}
