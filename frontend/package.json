{
  "name": "atelier-2-cockpit",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "check:dead": "knip --production",
    "generate:api": "orval --config orval.config.ts",
    "check:generated": "npm run generate:api && git add -N -- src/api/generated && git diff --exit-code -- src/api/generated",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:reversed": "E2E_ORDER=reversed playwright test"
  },
  "dependencies": {
    "svelte": "5.56.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.22.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "orval": "8.28.1",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
